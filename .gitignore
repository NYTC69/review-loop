.DS_Store
.claude/
.worktrees/
node_modules/
# Session files and tmp output of the legacy workflow (removed in v2.13.1). Nothing writes them now, but old
# checkouts still have them on disk; keep them ignored so they never enter a review scope or a commit.
.review-loop/sessions/
.review-loop/tmp/
tests/skills/.artifacts/
tests/skills/.last-run.json
HANDOFF.md

# Compass local state/cache/checkpoints are ephemeral by spec.
.compass/

# Environment & config
.env
.env.*
*.env
!.env.example
!.env.sample

# Keys & certificates
*.pem
*.key
*.crt
*.cert
*.cer
*.p12
*.pfx
*.jks
*.keystore

# SSH key files
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# PGP / GPG
*.asc
*.gpg
*.pgp

# Cloud credentials
*credentials*
!*credentials.example*
!*credentials.sample*
service-account*.json
.aws/
.gcloud/

# Generic secret files
*secret*
!*secret.example*
!*secret.sample*
secrets.*
!secrets.example*
!secrets.sample*

# Database & dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Compiled source maps
*.map

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/

# Logs
*.log
logs/

# Python bytecode caches (pytest creates these)
__pycache__/
*.pyc
paired_session/test-tmp/
