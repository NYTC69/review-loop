      ],
      "window_lines": 1
    },
    {
      "id": "sandbox_affected_code_simplifier_name_requires_adjacent_critical_warning",
      "kind": "pattern_requires_adjacent",
      "applies_to": "all-skill-bodies",
      "needle": "subagent_type: review-loop:code-simplifier",
      "required_nearby": [
        "CRITICAL"
      ],
      "window_lines": 1
