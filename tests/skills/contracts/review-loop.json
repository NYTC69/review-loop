      "kind": "contains",
      "path": "CLAUDE.md",
      "needle": "Never use `subagent_type: review-loop:<name>`."
    },
    {
      "id": "claude_plugin_agent_type_forbidden",
      "kind": "forbidden_line_pattern",
      "applies_to": "all-skill-bodies",
      "pattern": "^\\s*subagent_type:\\s*(?P<quote>['\\\"]?)review-loop:[^\\s'\\\"`#]+(?P=quote)\\s*(?:#.*)?$"
    },
    {
